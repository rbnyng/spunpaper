# Shared path configuration.
#
# Every value uses the KEY="${KEY:-default}" form, so precedence is:
#
#     environment variable  >  this file  >  (nothing else)
#
# To reproduce on different infrastructure you should only need to change the
# four roots in the first block; everything below is derived from them. You can
# also leave this file untouched and export the variables instead, e.g.
#
#     SPUN_DATA_ROOT=/my/data SPUN_SCRATCH=/my/scratch python src/spun_train_patch.py
#
# Shell scripts source this file directly. Python reads it via `src/paths.py`,
# which applies the same precedence. Point either at a different file with
# SPUN_CONFIG=/path/to/other.env.

# --- roots (change these) ---------------------------------------------------
# If you unpacked this tree BESIDE the original config_src rather than over it,
# SPUN_RESULTS_ROOT is the one line to revisit. Left as-is, a run writes into the
# old results directory and mixes new output with the numbers already in the
# manuscript. Point it at this checkout instead, e.g.
#
#     SPUN_RESULTS_ROOT="${SPUN_RESULTS_ROOT:-/maps-priv/maps/ray25/config_src2}"
#
# so the published results survive untouched as a comparison baseline.
#
# REPRESENTATIONS_DIR is safe to share with the old pipeline *if* the cache was
# written at the same patch size. It is keyed by sample_id alone, so a 3x3 run
# against a 5x5 cache would refetch and overwrite everything -- the extractor now
# refuses rather than doing that. `./run_all.sh --check` reports what is on disk.
SPUN_DATA_ROOT="${SPUN_DATA_ROOT:-/maps-priv/maps/ray25/data}"
SPUN_SCRATCH="${SPUN_SCRATCH:-/scratch/ray25}"
SPUN_RESULTS_ROOT="${SPUN_RESULTS_ROOT:-/maps-priv/maps/ray25/config_src}"
SPUN_NATIONALPARKS="${SPUN_NATIONALPARKS:-/maps-priv/maps/ray25/nationalparks}"

# --- deposited feature caches -------------------------------------------------
# The per-sample caches are published, so reproduction needs no fetching. Point
# DEPOSIT_DIR at the extracted archive and set the four cache paths to it;
# run_all.sh then skips stage 1 entirely.
DEPOSIT_DIR="${DEPOSIT_DIR:-}"
DEPOSIT_URL="${DEPOSIT_URL:-}"

# --- ground truth ------------------------------------------------------------
ECM_EUROPE_CSV="${ECM_EUROPE_CSV:-${SPUN_DATA_ROOT}/spun_data/ECM_richness_europe.csv}"
ECM_ASIA_CSV="${ECM_ASIA_CSV:-${SPUN_DATA_ROOT}/spun_data/ECM_richness_Asia.csv}"

# --- satellite features ------------------------------------------------------
# Per-sample Tessera patch cache; also the geotessera fetch target.
REPRESENTATIONS_DIR="${REPRESENTATIONS_DIR:-${SPUN_DATA_ROOT}/ecm_representations}"

# Feature caches used only by the supplementary analyses. Each is deposited
# alongside the main cache; leave unset and run_all.sh skips the stage that
# needs it rather than failing.
#   P7   -> 7x7 patches, centre-cropped per window by the patch-size ablation
#   SPECTRAL -> hand-crafted spectral-index baseline, same samples and window
#   YEAR_CACHE_TEMPLATE -> one 3x3 cache per embedding year; {year} is substituted
REPRESENTATIONS_P7_DIR="${REPRESENTATIONS_P7_DIR:-${SPUN_DATA_ROOT}/ecm_tessera_p7}"
SPECTRAL_REPRESENTATIONS_DIR="${SPECTRAL_REPRESENTATIONS_DIR:-${SPUN_DATA_ROOT}/spectral_representations}"
# NB: the {year} placeholder cannot go inside ${VAR:-default} -- bash ends the
# parameter expansion at the first '}', silently yielding tessera_{year_p3}.
if [ -z "${YEAR_CACHE_TEMPLATE:-}" ]; then
  YEAR_CACHE_TEMPLATE="${SPUN_DATA_ROOT}/caches/tessera_{year}_p3"
fi

# --- environmental covariates ------------------------------------------------
WORLDCLIM_DIR="${WORLDCLIM_DIR:-${SPUN_DATA_ROOT}/worldclim/data}"
CLIMATE_CACHE_DIR="${CLIMATE_CACHE_DIR:-${SPUN_SCRATCH}/climate_features_cache}"
CLIMATE_METADATA_CACHE="${CLIMATE_METADATA_CACHE:-${SPUN_SCRATCH}/climate_metadata_cache_v3.pkl}"
SOIL_CACHE_DIR="${SOIL_CACHE_DIR:-${SPUN_SCRATCH}/soil_features_cache}"
WORLDCOVER_CSV="${WORLDCOVER_CSV:-${SPUN_SCRATCH}/worldcover_features.csv}"
WORLDCOVER_TILES="${WORLDCOVER_TILES:-${SPUN_SCRATCH}/worldcover_tiles}"
ECOREGIONS_CACHE="${ECOREGIONS_CACHE:-${SPUN_SCRATCH}/ecoregions_cache}"

# --- outputs -----------------------------------------------------------------
RESULTS_DIR="${RESULTS_DIR:-${SPUN_RESULTS_ROOT}/patch_climate_representation_results}"
PATCH_PROC_TMP="${PATCH_PROC_TMP:-${SPUN_SCRATCH}/spun_patch_proc/tmp}"

# --- raw Sentinel acquisition (src/acquisition) ------------------------------
# Interpreter the acquisition shell drivers invoke. Set to `python3` (or your own
# environment) when reproducing; the default is the environment these were run in.
ACQ_PYTHON_ENV="${ACQ_PYTHON_ENV:-/maps/zf281/miniconda3/envs/detectree-env/bin/python}"
ACQ_DATA_ROOT="${ACQ_DATA_ROOT:-/scratch/zf281/create_d-pixels_biomassters/data}"
ACQ_LOG_DIR="${ACQ_LOG_DIR:-${ACQ_DATA_ROOT}/test_agbm_d-pixel/logs_s2}"
