# Self-contained configuration for this checkout.
#
# config.env carries the defaults for the machine the study was run on, where the
# caches live under /maps-priv and /scratch. This file points at the copies that
# ship inside this tree instead, so the pipeline runs with no external paths:
#
#     SPUN_CONFIG=code/config.local.env code/run_all.sh
#
# Paths are relative to the repository root, so run from there.

# SPUN_ROOT defaults to the checkout root: src/paths.py fills it in, and the
# shell drivers set it from their own location before sourcing this file.
SPUN_ROOT="${SPUN_ROOT:-.}"

# --- deposited feature caches (no fetching, no rasters, no GPU) --------------
DEPOSIT_DIR="${DEPOSIT_DIR:-${SPUN_ROOT}/caches/deposit}"
CLIMATE_CACHE_DIR="${CLIMATE_CACHE_DIR:-${DEPOSIT_DIR}/climate_features_cache}"
SOIL_CACHE_DIR="${SOIL_CACHE_DIR:-${DEPOSIT_DIR}/soil_features_cache}"
WORLDCOVER_CSV="${WORLDCOVER_CSV:-${DEPOSIT_DIR}/worldcover_features.csv}"

# WorldClim rasters are not required when the climate cache covers every sample,
# which it does here; leave this empty to take the cache path.
WORLDCLIM_DIR="${WORLDCLIM_DIR:-}"

# --- ground truth -------------------------------------------------------------
ECM_EUROPE_CSV="${ECM_EUROPE_CSV:-${SPUN_ROOT}/caches/ground_truth/ECM_richness_europe.csv}"
ECM_ASIA_CSV="${ECM_ASIA_CSV:-${SPUN_ROOT}/caches/ground_truth/ECM_richness_Asia.csv}"

# --- satellite features -------------------------------------------------------
REPRESENTATIONS_DIR="${REPRESENTATIONS_DIR:-${DEPOSIT_DIR}/ecm_representations}"

# --- outputs ------------------------------------------------------------------
SPUN_RESULTS_ROOT="${SPUN_RESULTS_ROOT:-${SPUN_ROOT}/results}"
RESULTS_DIR="${RESULTS_DIR:-${SPUN_RESULTS_ROOT}/patch_climate_representation_results}"
SPUN_SCRATCH="${SPUN_SCRATCH:-${SPUN_ROOT}/scratch}"
PATCH_PROC_TMP="${PATCH_PROC_TMP:-${SPUN_SCRATCH}/tmp}"
