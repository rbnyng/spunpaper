# Configuration for the bundled 5% reproduction sample.
#
#     tar -xJf reprod_sample.tar.xz
#     SPUN_CONFIG=config.sample.env ./run_all.sh
#
# Paths are relative to the repository root, so run from there. Anchored on
# SPUN_DATA_ROOT rather than a custom variable because src/paths.py only expands
# ${...} for keys it knows; anything else reaches Python as a literal string.
SPUN_DATA_ROOT="${SPUN_DATA_ROOT:-reprod_sample}"
SPUN_SCRATCH="${SPUN_SCRATCH:-${SPUN_DATA_ROOT}}"
SPUN_RESULTS_ROOT="${SPUN_RESULTS_ROOT:-sample_run}"
SPUN_NATIONALPARKS="${SPUN_NATIONALPARKS:-${SPUN_DATA_ROOT}/nationalparks}"

ECM_EUROPE_CSV="${ECM_EUROPE_CSV:-${SPUN_DATA_ROOT}/ECM_richness_europe.csv}"
ECM_ASIA_CSV="${ECM_ASIA_CSV:-${SPUN_DATA_ROOT}/ECM_richness_Asia.csv}"

REPRESENTATIONS_DIR="${REPRESENTATIONS_DIR:-${SPUN_DATA_ROOT}/ecm_representations}"
REPRESENTATIONS_P7_DIR="${REPRESENTATIONS_P7_DIR:-${SPUN_DATA_ROOT}/ecm_tessera_p7}"
SPECTRAL_REPRESENTATIONS_DIR="${SPECTRAL_REPRESENTATIONS_DIR:-${SPUN_DATA_ROOT}/spectral_p3}"
if [ -z "${YEAR_CACHE_TEMPLATE:-}" ]; then
  YEAR_CACHE_TEMPLATE="${SPUN_DATA_ROOT}/tessera_{year}_p3"
fi

# WorldClim is absent from the sample; the deposited climate cache covers every
# sampled point, so the extractor proceeds from cache alone.
WORLDCLIM_DIR="${WORLDCLIM_DIR:-${SPUN_DATA_ROOT}/worldclim}"
CLIMATE_CACHE_DIR="${CLIMATE_CACHE_DIR:-${SPUN_DATA_ROOT}/climate_features_cache}"
SOIL_CACHE_DIR="${SOIL_CACHE_DIR:-${SPUN_DATA_ROOT}/soil_features_cache}"
WORLDCOVER_CSV="${WORLDCOVER_CSV:-${SPUN_DATA_ROOT}/worldcover_features.csv}"

# Downloaded at runtime (RESOLVE ecoregions, ~376 MB), kept out of the sample
# directory so it is not mistaken for deposited data.
ECOREGIONS_CACHE="${ECOREGIONS_CACHE:-${SPUN_RESULTS_ROOT}/ecoregions_cache}"

RESULTS_DIR="${RESULTS_DIR:-${SPUN_RESULTS_ROOT}/results}"
